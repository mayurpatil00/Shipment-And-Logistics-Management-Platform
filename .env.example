# Copy this file to .env and fill in real values before running `docker compose up`.
# NEVER commit the actual .env file.
MYSQL_ROOT_PASSWORD=changeme
APP_JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes-long
APP_JWT_EXPIRATION_MS=3600000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_ADMIN_EMAIL=admin@logistics.local
APP_ADMIN_DEFAULT_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
